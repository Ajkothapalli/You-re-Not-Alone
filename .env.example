# ============================================================
# You Are Not Alone — environment variables
#
# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit real values.
# ============================================================


# ── Client bundle (safe to expose — baked into the app at build time) ─────────
# Only these two vars belong in the Expo client. Nothing else.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: analytics ingest key (PostHog project API key, or your provider's key).
# When absent, analytics events are logged to console in dev and dropped in prod.
EXPO_PUBLIC_ANALYTICS_KEY=


# ── Edge Function secrets (set via: supabase secrets set KEY=value) ───────────
# These never appear in the client bundle. They live only in the Edge Function
# runtime. See the "Secrets" section in CLAUDE.md for the full location matrix.

# HMAC key for author_token derivation.
# Generate: openssl rand -hex 64
# Rotation requires re-hashing all existing tokens — treat as permanent.
AUTHOR_TOKEN_SECRET=

# OpenAI key scoped to the Moderation API (omni-moderation-latest).
# Must have: POST /v1/moderations
MODERATION_API_KEY=

# OpenAI key for the gpt-4o-mini crisis classifier.
# Can be the same key as MODERATION_API_KEY if your org uses a single key.
# Must have: POST /v1/chat/completions
OPENAI_API_KEY=

# OpenAI key for text-embedding-3-small (dimensions=1536).
# Must have: POST /v1/embeddings
EMBEDDING_API_KEY=

# Set to "production" to enable hard blocks when API keys are absent.
# In development (any other value), missing keys log a warning and pass through
# so the UI can be tested without API credentials.
ENVIRONMENT=development

# Auto-injected by Supabase into the Edge Function runtime.
# DO NOT set this manually — it will be ignored or cause errors.
# SUPABASE_SERVICE_ROLE_KEY=(auto-injected)


# ── RevenueCat (EXPO_PUBLIC_* baked into client bundle; others are Edge Function secrets) ──
# Public SDK keys — from RevenueCat dashboard → Apps → iOS / Android → Public SDK key.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Webhook shared secret — choose any strong random string, then:
#   supabase secrets set RC_WEBHOOK_SECRET=<value>
#   Set the same value in RevenueCat dashboard → Integrations → Webhooks → Authorization header.
RC_WEBHOOK_SECRET=


# ── NCMEC CyberTipline (Edge Function secrets — mandatory before launch) ───────
# Required by 18 U.S.C. § 2258A. Complete the ESP agreement first:
#   https://www.missingkids.org/gethelpnow/cybertipline
# NCMEC issues these credentials after platform approval.
NCMEC_ESP_ID=
NCMEC_API_KEY=

# ── Store review account ──────────────────────────────────────────────────────
# The one address that signs in with a password instead of an emailed code, so
# an app-store reviewer can get in without access to a mailbox (Google Play
# rejects builds whose only sign-in routes require an external inbox or a
# second device). Not a backdoor: ordinary Supabase email+password auth for one
# unprivileged account. The PASSWORD is never here — it lives in the Supabase
# user list and in Play Console → App content → App access.
# Leave empty to disable the branch entirely.
EXPO_PUBLIC_REVIEW_EMAIL=
