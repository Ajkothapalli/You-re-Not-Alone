{
  "expo": {
    "name": "soulyap",
    "slug": "you-are-not-alone",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e30157a-f0cf-4d56-9af9-b10d30396387",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "soulyap",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.soulyap.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "me.soulyap.app",
      "versionCode": 40
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "backgroundColor": "#F7F4EF"
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "soulyap uses the microphone to turn speech into text on this device, and \u2014 if you choose to record a voice confession \u2014 to save that recording and play it to other people. You hear it before anything is posted.",
          "speechRecognitionPermission": "soulyap turns your speech into text on this device so you can speak a confession instead of typing it. Dictation keeps no recording; a voice confession saves one and plays it to other people.",
          "androidSpeechServicePackages": [
            "com.google.android.as"
          ]
        }
      ],
      "./plugins/withOptionalMicrophone",
      "expo-audio"
    ],
    "extra": {
      "supabaseUrl": "$EXPO_PUBLIC_SUPABASE_URL",
      "supabaseAnonKey": "$EXPO_PUBLIC_SUPABASE_ANON_KEY",
      "router": {},
      "eas": {
        "projectId": "1e30157a-f0cf-4d56-9af9-b10d30396387"
      }
    }
  }
}
